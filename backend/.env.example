# Copy to backend/.env and fill in the two keys below. Never commit backend/.env.
#
# Avoid "$" in values: docker compose tries to interpolate variables from it
# when it reads this file through env_file.

# Django secret key. Generate one with:
#   docker compose run --rm --no-deps backend python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# Fernet key used to encrypt the CPF at rest and to compute its HMAC-SHA256
# uniqueness hash. Generate one with:
#   docker compose run --rm --no-deps backend python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing this key makes stored CPFs unreadable and breaks the
# uniqueness check for existing accounts.
FIELD_ENCRYPTION_KEY=change-me

DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5190

# Local Postgres from docker-compose.yml (dev-only credentials).
# DB_HOST is overridden to "db" inside docker compose.
DB_NAME=dublacon
DB_USER=dublacon
DB_PASSWORD=dublacon
DB_HOST=localhost
DB_PORT=5432

# Optional. In dev, emails (password reset) are printed to the backend logs.
# FRONTEND_URL=http://localhost:5190
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=DublaCon <no-reply@example.com>
# SMTP settings (EMAIL_HOST, EMAIL_PORT, EMAIL_HOST_USER, EMAIL_HOST_PASSWORD,
# EMAIL_USE_TLS) are not read from the environment yet; add them to
# dublacon/settings.py before switching to the SMTP backend.
